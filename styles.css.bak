/* NTTU_LOGO_OVERRIDE: Add custom university logo styles below */
.brand img {
  display: block;
  width: 60px;
  height: 60px;
  object-fit: contain;
  transition: transform .3s ease;
}
.brand:hover img {
  transform: scale(1.055);
}
@media (max-width: 800px) {
  .brand img {
    width: 50px;
    height: 50px;
  }
}